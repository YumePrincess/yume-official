{
  "name": "yume-aio-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "api.yume.zone",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026071801",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "r2",
      "bucket_name": "yume-public"
    }
  ],
  "secrets": {
    "required": ["DEEPL_API_KEY", "AI_API_KEY"]
  },
  "vars": {
    "ANNOUNCEMENTS_CONFIG_KEY": "announcements/config.json",
    "AI_GATEWAY_ID": "default",
    "AI_CHAT_MODELS": "@cf/openai/gpt-oss-20b",
    "AI_EMBEDDING_MODELS": "@cf/baai/bge-m3"
  }
}
