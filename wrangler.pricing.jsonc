{
  "name": "yume-pricing",
  "compatibility_date": "2026-07-18",
  "workers_dev": false,
  "build": {
    "command": "node ./scripts/build-static.mjs --site pricing"
  },
  "assets": {
    "directory": "./dist/pricing",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "pricing.yume.zone",
      "custom_domain": true
    }
  ]
}
