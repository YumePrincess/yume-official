{
  "name": "yume-official",
  "main": "backend/worker.js",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pricing"]
  },
  "r2_buckets": [
    {
      "binding": "r2",
      "bucket_name": "yume-public"
    }
  ],
  "routes": [
    {
      "pattern": "www.yume.zone",
      "custom_domain": true
    },
    {
      "pattern": "yume.zone",
      "custom_domain": true
    }
  ],
  "vars": {
    "ANNOUNCEMENTS_CONFIG_KEY": "announcements/config.json",
    "DEEPL_API_KEY": "[DEEPL_API_KEY 已脱敏]"
  }
}
