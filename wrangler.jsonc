{
  "name": "yume-all-in-one-frontend",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "assets": {
    "directory": "./frontend",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "yume.zone",
      "custom_domain": true
    },
    {
      "pattern": "www.yume.zone",
      "custom_domain": true
    }
  ]
}
