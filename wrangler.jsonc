{
  "name": "yume-all-in-one-frontend",
  "compatibility_date": "2026-07-18",
  "workers_dev": false,
  "main": "./worker.mjs",
  "build": {
    "command": "node ./scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./dist/official",
    "binding": "ASSETS",
    "run_worker_first": ["/font/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "yume.zone",
      "custom_domain": true
    },
    {
      "pattern": "www.yume.zone",
      "custom_domain": true
    }
  ]
}
