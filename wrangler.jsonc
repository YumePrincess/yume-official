{
  "name": "yume-official",
  "compatibility_date": "2026-07-18",
  "workers_dev": false,
  "build": {
    "command": "node ./scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./dist/official",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "yume.zone",
      "custom_domain": true
    },
    {
      "pattern": "www.yume.zone",
      "custom_domain": true
    }
  ]
}
