{
  "name": "yume-official-backend",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Yume Official Backend on Cloudflare Workers, R2, and D1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/styles/tailwind.css -o ./public/css/tailwind.css --minify",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/styles/tailwind.css -o ./public/css/tailwind.css --minify",
    "predev": "npm run build",
    "dev": "node ./node_modules/wrangler/bin/wrangler.js dev",
    "predeploy": "npm run build",
    "deploy": "node ./node_modules/wrangler/bin/wrangler.js deploy",
    "types": "node ./node_modules/wrangler/bin/wrangler.js types",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "tail": "node ./node_modules/wrangler/bin/wrangler.js tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
