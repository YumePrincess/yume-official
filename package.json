{
  "name": "yume-official",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build-static.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "types": "wrangler types --config wrangler.api.jsonc --include-runtime false",
    "types:check": "wrangler types --config wrangler.api.jsonc --include-runtime false --check",
    "check": "node --check backend/worker.js && npm run types:check && npm test",
    "deploy:official": "wrangler deploy --config wrangler.jsonc",
    "deploy:search": "wrangler deploy --config wrangler.search.jsonc",
    "deploy:pricing": "wrangler deploy --config wrangler.pricing.jsonc",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc"
  },
  "devDependencies": {
    "wrangler": "4.112.0"
  }
}
