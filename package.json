{
  "name": "yume-all-in-one-backend",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Yume AIO Backend on Cloudflare Workers, R2, and D1",
  "packageManager": "npm@12.0.1",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/tailwind.css --minify",
    "predev": "npm run build",
    "dev": "wrangler dev",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
